    ? `\nPLAYER INVENTORY:\n${prof le. nventory.map(  => `- ${ .name} (${ .type}${ .rar ty ? `, ${ .rar ty}` : ''}): ${ .descr pt on} [Qty: ${ .quant ty}]`).jo n('\n')}\n`
    : '';

  const pp = prof le.playerProf le;
  return `\nPLAYER CHARACTER:
Name: ${pp?.name || 'The Protagon st'}
Descr pt on: ${pp?.descr pt on || 'A myster ous traveler'}
Personal ty: ${pp?.personal ty || 'Unknown'}
Backstory: ${pp?.backstory || 'Unknown'}
Appearance: ${pp?.appearance || 'Unknown'}
Cloth ng: ${pp?.cloth ng || 'Unknown'}
Accessor es: ${pp?.accessor es || 'None'}
Ha r: ${pp?.ha rStyle || 'Unknown'} ${pp?.ha rColor || ''}
Eyes: ${pp?.eyeColor || 'Unknown'}
${prof le.mode === AppMode.GAME ? `Class: ${pp?.playerClass || 'Unknown'}\nRace: ${pp?.playerRace || 'Unknown'}\nHP: ${pp?.currentHP ?? '?'}/${pp?.maxHP ?? '?'}\nLevel: ${pp?.level ?? 1}\nXP: ${pp?.xp ?? 0}` : ''}
${ nventoryBlock}`;
}

funct on bu ldSystemInstruct on(prof le: CharacterProf le, codexEntr es: CodexEntry[], currentSummary: str ng, customInstruct ons?: str ng): str ng {
  const codexContext = codexEntr es.length > 0
    ? `\nWORLD CODEX (Lore & Rules - Most Relevant):\n${codexEntr es.sl ce(-15).map(e => `[${e.category}: ${e.t tle}] - ${e.content}`).jo n('\n')}\n`
    : '';

  const summaryContext = currentSummary ? `\nSTORY SUMMARY SO FAR:\n${currentSummary}\n` : '';

