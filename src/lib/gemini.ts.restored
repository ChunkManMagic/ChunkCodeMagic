    y eld* generateOpenRouterStream(h story, systemInstruct on, userInput, sett ngs);
    return;
  }

  const a  = getGenAI();
  
  let chat;
  let responseStream;
  try {
    chat = a .chats.create({
      model: sett ngs.act veModel,
      conf g: { systemInstruct on },
      h story: bu ldH story(h story)
    });
    responseStream = awa t chat.sendMessageStream({ message: userInput });
  } catch (err: any) {
    const  sFallbackableError = 
      err?.message?. ncludes('Perm ss on Den ed') || 
      err?.status === 403 || 
      err?.code === 403 ||
      err?.status === 429 ||
      err?.code === 429 ||
      Str ng(err). ncludes('PERMISSION_DENIED') ||
      Str ng(err). ncludes('RESOURCE_EXHAUSTED') ||
      Str ng(err). ncludes('429') ||
      Str ng(err). ncludes('403');

     f ( sFallbackableError && sett ngs.act veModel !== 'gem n -3.5-flash') {
      console.warn(`generateTextReplyStream: Fallback to gem n -3.5-flash due to error w th ${sett ngs.act veModel}:`, err.message);
      chat = a .chats.create({
        model: 'gem n -3.5-flash',
        conf g: { systemInstruct on },
        h story: bu ldH story(h story)
      });
      responseStream = awa t chat.sendMessageStream({ message: userInput });
    } else {
      throw err;
    }
  }
  
  for awa t (const chunk of responseStream) {
    y eld chunk.text || "";
  }
}

export async funct on suggestNextAct on(
  h story: any[], 
  prof le: CharacterProf le, 
  codexEntr es: CodexEntry[] = [], 
  currentSummary: str ng = "", 
  gu de?: str ng, 
  customInstruct ons?: str ng
): Prom se<str ng> {
  const codexContext = codexEntr es.length > 0
    ? `\nWORLD CODEX (Lore & Rules - Most Relevant):\n${codexEntr es.sl ce(-15).map(e => `[${e.category}: ${e.t tle}] - ${e.content}`).jo n('\n')}\n`
    : '';

  const summaryContext = currentSummary ? `\nSTORY SUMMARY SO FAR:\n${currentSummary}\n` : '';

  const styleInstruct on = customInstruct ons
    ? `\nCustom Wr t ng Style Instruct ons (Apply these to the suggest on):\n${customInstruct ons}\n`
    : '';

  const modeInstruct on = prof le.mode === AppMode.GAME
    ? `You are ass st ng a player  n a tabletop RPG. Suggest one compell ng next act on for THEIR character. It must be wr tten  n the f rst person (or the player's preferred style) and be ready to send as a message. It should feel l ke a real game dec s on (attack,  nvest gate, negot ate, use an  tem, cast a spell, etc.).`
    : prof le.mode === AppMode.SCENARIO
    ? `You are ass st ng a player  n an  nteract ve narrat ve. Suggest one compell ng next act on for THEIR character that mean ngfully advances or compl cates the story. Wr te  t as the actual text the player would send.`
    : `You are ass st ng a player  n a character roleplay. Suggest one compell ng next d alogue l ne or act on for THEIR character that f ts the r character vo ce and advances the scene. Wr te  t as the actual text the player would send.`;

  const gu deInstruct on = gu de ? `\nThe player has prov ded a h nt/gu de for what they want to do: "${gu de}". Use th s to shape your suggest on.\n` : '';

  const systemInstruct on = `${modeInstruct on}
${gu deInstruct on}
${styleInstruct on}
${bu ldPlayerBlock(prof le)}

They are  nteract ng w th /  n the world of:
Name: ${prof le.name}
Personal ty: ${prof le.personal ty}
Relat onsh p: ${prof le.relat onsh p}
Tone: ${prof le.storyTone}

World Context: ${prof le.worldAtmosphere || 'Not spec f ed'}
Key Locat ons: ${prof le.keyLocat ons || 'Not spec f ed'}
${codexContext}${summaryContext}

IMPORTANT: Return ONLY the suggested text, ready to use as player  nput. 
- Do NOT say "You should..." or "I suggest...".
- Do NOT use quotes.
- Do NOT prov de explanat ons.
- Wr te the ACTUAL message the player would send to the AI.`;

  const sett ngs = getSett ngs();

   f (sett ngs.act veTextProv der === 'OpenRouter') {
    return callOpenRouter(h story, systemInstruct on, `Based on the current s tuat on and my character prof le, what  s the best next act on or d alogue for me to take? Prov de the text I should send.`, sett ngs);
  }

  const a  = getGenAI();

  let chat: any;
  let response: any;
  try {
    chat = a .chats.create({
      model: sett ngs.act veModel,
      conf g: { systemInstruct on },
      h story: bu ldH story(h story)
    });
    response = awa t w thRetry(() => chat.sendMessage({ message: `Based on the current s tuat on and my character prof le, what  s the best next act on or d alogue for me to take? Prov de the text I should send.` }));
  } catch (err: any) {
    const  sFallbackableError = 
      err?.message?. ncludes('Perm ss on Den ed') || 
      err?.status === 403 || 
      err?.code === 403 ||
      err?.status === 429 ||
      err?.code === 429 ||
      Str ng(err). ncludes('PERMISSION_DENIED') ||
      Str ng(err). ncludes('RESOURCE_EXHAUSTED') ||
      Str ng(err). ncludes('429') ||
      Str ng(err). ncludes('403');

     f ( sFallbackableError && sett ngs.act veModel !== 'gem n -3.5-flash') {
      console.warn(`suggestNextAct on: Fallback to gem n -3.5-flash due to error w th ${sett ngs.act veModel}:`, err.message);
      chat = a .chats.create({
        model: 'gem n -3.5-flash',
        conf g: { systemInstruct on },
        h story: bu ldH story(h story)
      });
      response = awa t w thRetry(() => chat.sendMessage({ message: `Based on the current s tuat on and my character prof le, what  s the best next act on or d alogue for me to take? Prov de the text I should send.` }));
    } else {
      throw err;
    }
  }
  return response.text?.tr m() || "";
}

