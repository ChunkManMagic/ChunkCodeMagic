export async funct on summar zeH story(h story: any[], prev ousSummary: str ng = ""): Prom se<str ng> {
  const sett ngs = getSett ngs();
  const prompt = `Rev ew the current story summary and the follow ng new events. Prov de an updated, conc se summary that captures all major plot po nts and character developments.

CRITICAL: Ma nta n clear d st nct on between the player's act ons/words and the AI characters' act ons/words. Do not blend them.

Current Summary: ${prev ousSummary}
New Events:
${JSON.str ng fy(h story)}

Updated Summary:`;

   f (sett ngs.act veTextProv der === 'OpenRouter') {
    return callOpenRouter([], "You are a profess onal narrat ve ed tor. Prov de a conc se, clear summary of story developments wh le ma nta n ng character agency d st nct ons. Return ONLY the summary text.", prompt, sett ngs);
  }

  const a  = getGenAI();
  let response;
  try {
    response = awa t w thRetry(() => a .models.generateContent({
      model: sett ngs.act veModel,
      contents: prompt
    }));
  } catch (err: any) {
    const  sFallbackableError = 
      err?.message?. ncludes('Perm ss on Den ed') || 
      err?.status === 403 || 
      err?.code === 403 ||
      err?.status === 429 ||
      err?.code === 429 ||
      Str ng(err). ncludes('PERMISSION_DENIED') ||
      Str ng(err). ncludes('RESOURCE_EXHAUSTED') ||
      Str ng(err). ncludes('429') ||
      Str ng(err). ncludes('403');

     f ( sFallbackableError && sett ngs.act veModel !== 'gem n -3.5-flash') {
      console.warn(`summar zeH story: Fallback to gem n -3.5-flash due to error w th ${sett ngs.act veModel}:`, err.message);
      response = awa t w thRetry(() => a .models.generateContent({
        model: 'gem n -3.5-flash',
        contents: prompt
      }));
    } else {
      throw err;
    }
  }
  return response.text?.tr m() || prev ousSummary;
}

export async funct on* generateTextReplyStream(h story: any[], prof le: CharacterProf le, userInput: str ng, codexEntr es: CodexEntry[] = [], currentSummary: str ng = "", customInstruct ons?: str ng) {
  const sett ngs = getSett ngs();
  const systemInstruct on = bu ldSystemInstruct on(prof le, codexEntr es, currentSummary, customInstruct ons);

