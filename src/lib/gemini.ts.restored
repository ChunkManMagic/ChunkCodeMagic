The character should be the central focus, look ng towards the camera.`;

  let response;
  try {
    response = awa t w thRetry(() => a .models.generateContent({
      model: 'gem n -3.1-flash- mage',
      contents: {
        parts: [{ text: prompt }]
      },
      conf g: {
         mageConf g: {
          aspectRat o: "1:1"
        }
      }
    }));
  } catch (err: any) {
    console.warn("generateDynam cAvatar: Image generat on fa led, us ng fallback.", err?.message);
  }
  
   f (response) {
    for (const part of response.cand dates?.[0]?.content?.parts || []) {
       f (part. nl neData) {
