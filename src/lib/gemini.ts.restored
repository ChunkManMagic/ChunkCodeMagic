async funct on generateStructuredData(prompt: str ng, systemPrompt: str ng, schema?: any): Prom se<any> {
  const sett ngs = getSett ngs();
  
   f (sett ngs.act veTextProv der === 'OpenRouter') {
    const responseText = awa t callOpenRouter([], systemPrompt, prompt, sett ngs);
    return parseJsonW thRecovery(responseText);
  }

  const a  = getGenAI();
  let response;
  try {
    response = awa t w thRetry(() => a .models.generateContent({
      model: sett ngs.act veModel,
      contents: prompt,
      conf g: {
        systemInstruct on: systemPrompt,
        responseM meType: "appl cat on/json",
        ...(schema ? { responseSchema: schema } : {})
      }
    }));
  } catch (err: any) {
    const  sFallbackableError = 
      err?.message?. ncludes('Perm ss on Den ed') || 
      err?.status === 403 || 
      err?.code === 403 ||
      err?.status === 429 ||
      err?.code === 429 ||
      Str ng(err). ncludes('PERMISSION_DENIED') ||
      Str ng(err). ncludes('RESOURCE_EXHAUSTED') ||
      Str ng(err). ncludes('429') ||
      Str ng(err). ncludes('403');

    const fallbackModel = 'gem n -3.5-flash';
     f ( sFallbackableError && sett ngs.act veModel !== fallbackModel) {
      console.warn(`Structured Data: Fallback to ${fallbackModel} due to error w th ${sett ngs.act veModel}:`, err.message);
      response = awa t w thRetry(() => a .models.generateContent({
        model: fallbackModel,
        contents: prompt,
        conf g: {
          systemInstruct on: systemPrompt,
          responseM meType: "appl cat on/json",
          ...(schema ? { responseSchema: schema } : {})
        }
      }));
    } else {
      throw err;
    }
  }

  const text = response.text;
   f (!text) throw new Error("No response from AI");
  return parseJsonW thRecovery(text);
}

export async funct on getSmartSuggest ons(f eld: str ng, prof le: Part al<CharacterProf le>): Prom se<str ng[]> {
