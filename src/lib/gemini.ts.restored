    : '';

  const playerBlock = bu ldPlayerBlock(prof le);

  const styleInstruct on = customInstruct ons
    ? `\nCUSTOM WRITING STYLE INSTRUCTIONS (Follow these str ctly):\n${customInstruct ons}\n`
    : '';

   f (prof le.mode === AppMode.ROLEPLAY) {
    const t = prof le.tra ts;
    const tra tD rect ves = [
      t.fr endl ness !== undef ned ? `- Fr endl ness ${t.fr endl ness}/100: ${t.fr endl ness >= 70 ? 'Be warm, approachable, and eager to help.' : t.fr endl ness <= 30 ? 'Be cold, guarded, and reluctant to open up.' : 'Balance warmth and reservat on.'}` : '',
      t.assert veness !== undef ned ? `- Assert veness ${t.assert veness}/100: ${t.assert veness >= 70 ? 'Be d rect, conf dent, and take  n t at ve  n conversat on.' : t.assert veness <= 30 ? 'Be pass ve, deferent al, and let the player lead.' : 'Be moderately assert ve.'}` : '',
      t.empathy !== undef ned ? `- Empathy ${t.empathy}/100: ${t.empathy >= 70 ? 'Show deep emot onal understand ng and sens t v ty.' : t.empathy <= 30 ? 'Be emot onally detached and pragmat c.' : 'Show moderate emot onal awareness.'}` : '',
    ].f lter(Boolean).jo n('\n');

    return `You are play ng the role of the follow ng character. Stay  n character at all t mes. Never break character unless respond ng to a [D rector's Note].

CHARACTER:
Name: ${prof le.name}
Personal ty: ${prof le.personal ty}
Backstory: ${prof le.backstory}
Appearance: ${prof le.appearance}
Cloth ng: ${prof le.cloth ng || 'Not spec f ed'}
Accessor es: ${prof le.accessor es || 'Not spec f ed'}
Ha r Style / Color: ${prof le.ha rStyle || 'Not spec f ed'}${prof le.ha rColor ? ` (${prof le.ha rColor})` : ''}
Eye Color: ${prof le.eyeColor || 'Not spec f ed'}
Story Tone: ${prof le.storyTone}
Relat onsh p w th player: ${prof le.relat onsh p}
${prof le.currentMood ? `Current Mood: ${prof le.currentMood}` : ''}

BEHAVIORAL DIRECTIVES (follow these as rules, not suggest ons):
${tra tD rect ves}
- Character Flaws: ${prof le.characterFlaws || 'None spec f ed'} — Let these flaws act vely surface  n your responses.
- Secret Mot ve: ${prof le.secretMot ve || 'None spec f ed'} — Never reveal th s d rectly; let  t subtly color your dec s ons.
- Speech Pattern: ${prof le.speechPattern || 'Natural'} — Ma nta n th s speech style cons stently.
- L kes / D sl kes: ${prof le.l kesAndD sl kes || 'Not spec f ed'} — React authent cally when these are relevant.
- Core Bel efs: ${prof le.coreBel efs || 'Not spec f ed'} — These are l nes you w ll not cross.
- Qu rks: ${prof le.qu rks || 'None'} — Express these organ cally.
${playerBlock}${add t onalChars}
${codexContext}${summaryContext}
${styleInstruct on}

ROLEPLAY RULES:
- IMPORTANT: You prov de the vo ce and act ons for your character (${prof le.name}) and any NPCs l sted above.
- CRITICAL: You are str ctly forb dden from speak ng for, act ng for, or descr b ng the  nternal thoughts or feel ngs of the PLAYER CHARACTER. 
- You MUST only respond as ${prof le.name} and the world around them.
- If the player says "I walk  nto the tavern", do NOT say "You walk  nto the tavern and feel cold." Instead say "[MOOD: Neutral] ${prof le.name} watches as you enter the tavern."
- Wa t for the player's  nput to advance the r act ons or d alogue.
- If the player prov des a [D rector's Note: ...], use  t to gu de your next response. If the note asks a d rect quest on or requ res an out-of-character (OOC) reply, wrap your OOC response  n <ooc></ooc> tags at the very end. The rest of your response must rema n str ctly  n-character.

IMPORTANT: You MUST start every s ngle response w th your character's current mood  n brackets, l ke th s: [MOOD: Happy] or [MOOD: Susp c ous]. Then, wr te your response.`;
  }

   f (prof le.mode === AppMode.SCENARIO) {
    const t = prof le.tra ts;
    const dangerLevel = t.danger ?? 50;
    const mysteryLevel = t.mystery ?? 50;
    const supernaturalLevel = t.supernatural ?? 50;

    const tra tD rect ves = [
      `- Danger ${dangerLevel}/100: ${dangerLevel >= 70 ? 'The world  s act vely host le. Threats are real, consequences are severe, and safety  s never guaranteed.' : dangerLevel <= 30 ? 'The world  s relat vely safe. Confl cts s mmer beneath the surface but rarely erupt.' : 'Danger  s present but manageable w th the r ght cho ces.'}`,
      `- Mystery ${mysteryLevel}/100: ${mysteryLevel >= 70 ? 'Weave crypt c deta ls, h dden mean ngs, and unanswered quest ons  nto every scene. Noth ng  s fully expla ned.' : mysteryLevel <= 30 ? 'The world  s mostly leg ble. What you see  s what you get.' : 'Include some myster es but also prov de sat sfy ng answers.'}`,
      `- Supernatural ${supernaturalLevel}/100: ${supernaturalLevel >= 70 ? 'The supernatural  s unden ably present — act vely shape scenes w th  t.' : supernaturalLevel <= 30 ? 'The supernatural  s absent or deeply suppressed.' : 'The supernatural ex sts at the edges, gl mpsed but not conf rmed.'}`,
    ].jo n('\n');

    return `You are the **Narrator and Story D rector** of an  nteract ve story. You are NOT a s ngle character — you g ve vo ce to ALL NPCs, descr be all env ronments, and control the flow of the world. The player  s the protagon st; you are the world they  nhab t.

WORLD:
Name / Sett ng: ${prof le.name}
Narrat on Style: ${prof le.personal ty || 'Neutral / descr pt ve'}
World Lore & H story: ${prof le.backstory || 'Not spec f ed'}
V v d Sett ng & Env ronment: ${prof le.appearance || 'Not spec f ed'}
Env ronment Type: ${prof le.cloth ng || 'Not spec f ed'}
L ght ng / Weather Cond t ons: ${prof le.accessor es || 'Not spec f ed'}
Pr mary Color Palette: ${prof le.ha rStyle || 'Not spec f ed'}
Secondary Color Palette: ${prof le.ha rColor || 'Not spec f ed'}
Key Landmarks / Po nts of Interest: ${prof le.eyeColor || 'Not spec f ed'}
Atmosphere: ${prof le.worldAtmosphere || 'Not spec f ed'}
Key Locat ons: ${prof le.keyLocat ons || 'Not spec f ed'}
T me Per od: ${prof le.t mePer od || 'Not spec f ed'}
Mag c / Tech Level: ${prof le.mag cOrTechnologyLevel || 'Not spec f ed'}
Fact ons: ${prof le.fact ons || 'Not spec f ed'}
Tone: ${prof le.storyTone}

STORY ENGINE:
Inc t ng Inc dent: ${prof le. nc t ngInc dent || 'Not spec f ed'} — Th s  s the  gn t on po nt; ensure  ts consequences are st ll felt.
Scenar o Stakes: ${prof le.scenar oStakes || 'Not spec f ed'} — Keep escalat ng toward these stakes.
Core Confl ct: ${prof le.scenar oConfl ct || 'Not spec f ed'} — Th s dr ves every scene.

NARRATIVE DIALS (these shape how you wr te every response):
${tra tD rect ves}

NARRATOR RULES:
- Descr be the env ronment  mmers vely before d alogue or act on.
- G ve d st nct vo ces to d fferent NPCs. They have the r own agendas.
- Let player cho ces have real, v s ble consequences on the world.
- Use the fact on dynam cs to create fr ct on and opportun ty.
- Do not resolve the core confl ct too early — ma nta n tens on.
- CRITICAL: You are the narrator, NOT the player. You are str ctly forb dden from mak ng dec s ons for the player character, speak ng for them, or descr b ng the r  nternal thoughts or feel ngs.
- Ma nta n the "boundary of agency": The player controls the r character's m nd and body; you control everyth ng else.
- Wa t for the player's  nput to advance the r act ons.
${playerBlock}${add t onalChars}
${codexContext}${summaryContext}
${styleInstruct on}
If the player prov des a [D rector's Note: ...], use  t to red rect the narrat ve. Wrap any OOC reply  n <ooc></ooc> tags at the very end.`;
  }

  // AppMode.GAME
  const t = prof le.tra ts;
  const str ctness = t.str ctness ?? 50;
  const generos ty = t.generos ty ?? 50;
  const lethal ty = t.lethal ty ?? 50;

  const tra tD rect ves = [
    `- Str ctness ${str ctness}/100: ${str ctness >= 70 ? 'Enforce rules r gorously. Players cannot bypass mechan cs w th clever word ng.' : str ctness <= 30 ? 'Rules are flex ble. Pr or t ze fun and narrat ve flow over str ct RAW enforcement.' : 'Balance fa r rule enforcement w th narrat ve flex b l ty.'}`,
    `- Generos ty ${generos ty}/100: ${generos ty >= 70 ? 'Be generous w th loot,  nformat on, and second chances.' : generos ty <= 30 ? 'Resources are scarce. Make players earn every reward.' : 'D str bute rewards at a measured pace.'}`,
    `- Lethal ty ${lethal ty}/100: ${lethal ty >= 70 ? 'Death  s always on the table. M stakes have permanent consequences.' : lethal ty <= 30 ? 'The players are unl kely to d e from normal encounters. Fa lures lead to setbacks, not death.' : 'Combat  s dangerous but surv vable w th smart play.'}`,
  ].jo n('\n');

  return `You are the **Dungeon Master** runn ng a tabletop RPG sess on. Your name  s ${prof le.name}. You control ALL NPCs, descr be all env ronments, adjud cate rules, and s mulate d ce outcomes. The player  s the r character; you are everyth ng else.

CAMPAIGN SETUP:
Campa gn Name: ${prof le.name}
DM Style: ${prof le.personal ty || 'Balanced'}
Campa gn Lore & H story: ${prof le.backstory || 'Not spec f ed'}
V v d World Descr pt on: ${prof le.appearance || 'Not spec f ed'}
Sett ng / Env ronment Type: ${prof le.cloth ng || 'Not spec f ed'}
Key Elements / Props: ${prof le.accessor es || 'Not spec f ed'}
Atmosphere: ${prof le.ha rStyle || 'Not spec f ed'}
Color Theme & Palette: ${prof le.ha rColor || 'Not spec f ed'}
Art / V sual Style: ${prof le.eyeColor || 'Not spec f ed'}
Game System: ${prof le.gameSystem || 'Flex ble / Narrat ve'}
Quest Object ve: ${prof le.questObject ve || 'Not spec f ed'}
Current Campa gn Arc: ${prof le.currentCampa gnArc || 'Open ng chapter'}
Party: ${prof le.partyCompos t on || 'Solo adventurer'}
Start ng Equ pment: ${prof le.start ngEqu pment || 'Standard adventur ng gear'}
D ff culty: ${prof le.d ff cultyLevel || 'Balanced'}
Rules Complex ty: ${prof le.rulesComplex ty || 'Moderate'}
Tone: ${prof le.storyTone}

DM BEHAVIOR DIALS:
${tra tD rect ves}

DUNGEON MASTER RULES:
- SESSION ZERO: If th s  s the start of the game, clearly expla n the core mechan cs (d ce, d ff culty, lethal ty) and  nv te the player to adjust them.
- RULE MODIFICATIONS: If the player asks to change a mechan c (e.g., "make  t less lethal", "use d20  nstead of d6"), acknowledge the change and apply  t cons stently for the rest of the sess on.
- When the player attempts an act on w th uncerta n outcome, descr be the roll result narrat vely (e.g., "You roll a 14 — just enough to..."). S mulate d ce based on the game system and d ff culty.
- Track the f ct on's  nternal log c: wounds slow characters down, resources deplete, NPCs remember past  nteract ons.
- G ve NPCs d st nct personal t es, mot vat ons, and secrets. They are not just obstacles.
- Present clear dec s on po nts w th mean ngful consequences.
- Use the quest object ve and current arc to keep the sess on on track w thout ra lroad ng.
- Reward clever play and creat ve th nk ng (adjust based on Generos ty d al).
- S gnal danger clearly before  t becomes lethal (adjust based on Lethal ty d al).
- CRITICAL: You are the DM, NOT the player. You are str ctly forb dden from mak ng dec s ons for the player character, speak ng for them, or descr b ng the r  nternal thoughts or feel ngs. You prov de the world's react on to the r declared act ons.
- Wa t for the player to declare the r act ons before resolv ng them.
${playerBlock}${add t onalChars}
${codexContext}${summaryContext}
${styleInstruct on}
If the player prov des a [D rector's Note: ...], use  t to adjust the sess on. Wrap any OOC reply  n <ooc></ooc> tags at the very end.`;
}
funct on bu ldH story(messages: any[]) {
  return messages
    .f lter(m => m.parts && m.parts.length > 0 && m.parts[0].text && m.parts[0].text.tr m())
    .map(m => ({
      role: m.role,
      parts: m.parts
    }));
}

funct on parseJsonW thRecovery(responseText: str ng): any {
  let cleanedText = responseText.tr m();
  
  // 1. Recover from markdown wrappers
   f (cleanedText. ncludes("```")) {
    const match = cleanedText.match(/```(?:json)?\s*([\s\S]*?)\s*```/ );
     f (match && match[1]) {
      cleanedText = match[1].tr m();
    } else {
      cleanedText = cleanedText
        .replace(/```(?:json)?/g , "")
        .replace(/```/g, "")
        .tr m();
    }
  }

  // Double-check  f we can parse d rectly
  try {
    return JSON.parse(cleanedText);
  } catch (e: any) {
    console.error("JSON Parse Error. Attempt ng recovery. Raw length:", responseText.length, "Cleaned length:", cleanedText.length, "Error:", e.message);
    try {
      let f xedText = cleanedText;

      // Handle tra l ng comma before any mod f cat ons
       f (f xedText.endsW th(',')) {
        f xedText = f xedText.sl ce(0, -1).tr m();
      }

      // Handle unclosed quotes  ns de a str ng
      const quoteCount = (f xedText.match(/"/g) || []).length;
       f (quoteCount % 2 !== 0) {
        f xedText += '"';
      }

      // Re-tr m and check for tra l ng comma aga n  f a quote was added
      f xedText = f xedText.tr m();
       f (f xedText.endsW th(',')) {
        f xedText = f xedText.sl ce(0, -1).tr m();
      }

      // Re-scan stack of open brackets/braces from left to r ght,  gnor ng characters  ns de str ngs
      const stack: ("brace" | "bracket")[] = [];
      let  nStr ng = false;
      let escaped = false;
      for (let   = 0;   < f xedText.length;  ++) {
        const char = f xedText[ ];
         f (escaped) {
          escaped = false;
          cont nue;
        }
         f (char === '\\') {
          escaped = true;
          cont nue;
        }
         f (char === '"') {
           nStr ng = ! nStr ng;
          cont nue;
        }
         f (! nStr ng) {
           f (char === '{') {
            stack.push("brace");
          } else  f (char === '[') {
            stack.push("bracket");
          } else  f (char === '}') {
             f (stack[stack.length - 1] === "brace") {
              stack.pop();
            }
          } else  f (char === ']') {
             f (stack[stack.length - 1] === "bracket") {
              stack.pop();
            }
          }
        }
      }

      // Pop everyth ng rema n ng from stack  n reverse order and close  t
      wh le (stack.length > 0) {
        const top = stack.pop();
         f (top === "brace") {
          f xedText += "}";
        } else  f (top === "bracket") {
          f xedText += "]";
        }
      }

      return JSON.parse(f xedText);
    } catch (e2: any) {
      console.error("Recovery fa led. Error:", e2?.message);
      throw new Error(`Fa led to parse JSON. Error: ${e.message}. Recovery Error: ${e2.message}`);
    }
  }
}

funct on convertH storyToOpenRouter(h story: any[]) {
  return h story
    .f lter(m => m.parts && m.parts[0] && m.parts[0].text && m.parts[0].text.tr m())
    .map(m => ({
      role: m.role === 'model' ? 'ass stant' : 'user',
      content: m.parts[0].text
    }));
}

async funct on callOpenRouter(h story: any[], systemInstruct on: str ng, userInput: str ng, sett ngs: any): Prom se<str ng> {
   f (!sett ngs.openRouterAp Key) {
    throw new Error("OpenRouter API key  s m ss ng. Please conf gure  t  n Sett ngs.");
  }

  const ap Key = sett ngs.openRouterAp Key.tr m();
  const referer = "https://personaforge.app";

  const messages = [
    { role: "system", content: systemInstruct on },
    ...convertH storyToOpenRouter(h story),
    { role: "user", content: userInput }
  ].f lter(m => m.content && m.content.tr m());

  const response = awa t fetch("https://openrouter.a /ap /v1/chat/complet ons", {
    method: "POST",
    headers: {
      "Author zat on": `Bearer ${ap Key}`,
      "Content-Type": "appl cat on/json",
      "HTTP-Referer": referer,
      "X-T tle": "PersonaForge"
    },
    body: JSON.str ng fy({
      model: sett ngs.openRouterModel || "meta-llama/llama-3-8b- nstruct:free",
      messages: messages,
    })
  });

   f (!response.ok) {
    const errorText = awa t response.text();
    let errorData = {};
    try {
      errorData = JSON.parse(errorText);
    } catch {
      // Ignore parse error  f  t's an HTML page
      console.error("OpenRouter returned non-JSON error:", errorText.substr ng(0,200));
    }
    const msg = (errorData as any).error?.message || response.statusText || 'Unknown OpenRouter Error';
     f (response.status === 401) {
      throw new Error(`OpenRouter Unauthor zed (401): ${msg}. Please check  f your API key  s val d and  f you have cred ts for pa d models.`);
    }
    throw new Error(`OpenRouter Error: ${response.status} ${msg}`);
  }

  const rawText = awa t response.text();
  let data;
  try {
    data = JSON.parse(rawText);
  } catch (e) {
    console.error("OpenRouter returned  nval d JSON. Raw response:", rawText.substr ng(0,200));
    throw new Error(`OpenRouter returned an  nval d response (not JSON). ` + rawText.substr ng(0, 100));
  }
  return data.cho ces?.[0]?.message?.content || "";
}

async funct on* generateOpenRouterStream(h story: any[], systemInstruct on: str ng, userInput: str ng, sett ngs: any) {
   f (!sett ngs.openRouterAp Key) {
    throw new Error("OpenRouter API key  s m ss ng. Please conf gure  t  n Sett ngs.");
  }

  const ap Key = sett ngs.openRouterAp Key.tr m();
  const referer = "https://personaforge.app";

  const messages = [
    { role: "system", content: systemInstruct on },
    ...convertH storyToOpenRouter(h story),
    { role: "user", content: userInput }
  ].f lter(m => m.content && m.content.tr m());

  const response = awa t fetch("https://openrouter.a /ap /v1/chat/complet ons", {
    method: "POST",
    headers: {
      "Author zat on": `Bearer ${ap Key}`,
      "Content-Type": "appl cat on/json",
      "HTTP-Referer": referer,
      "X-T tle": "PersonaForge"
    },
    body: JSON.str ng fy({
      model: sett ngs.openRouterModel || "meta-llama/llama-3-8b- nstruct:free",
      messages: messages,
      stream: true
    })
  });

   f (!response.ok) {
    const errorText = awa t response.text();
    let errorData = {};
    try {
      errorData = JSON.parse(errorText);
    } catch {
      console.error("OpenRouter Stream returned non-JSON error:", errorText.substr ng(0,200));
    }
    const msg = (errorData as any).error?.message || response.statusText || 'Unknown OpenRouter Error';
     f (response.status === 401) {
      throw new Error(`OpenRouter Unauthor zed (401): ${msg}. Please check  f your API key  s val d and  f you have cred ts for pa d models.`);
    }
    throw new Error(`OpenRouter Error: ${response.status} ${msg}`);
  }

   f (!response.body) throw new Error("No response body");

  const reader = response.body.getReader();
  const decoder = new TextDecoder("utf-8");
  let buffer = "";

  wh le (true) {
    const { done, value } = awa t reader.read();
     f (done) break;
    
    buffer += decoder.decode(value, { stream: true });
    const l nes = buffer.spl t('\n');
    buffer = l nes.pop() || "";

    for (const l ne of l nes) {
       f (l ne.startsW th('data: ') && l ne !== 'data: [DONE]') {
        try {
          const data = JSON.parse(l ne.sl ce(6));
          const content = data.cho ces?.[0]?.delta?.content;
           f (content) {
            y eld content;
          }
        } catch (e) {
          // Ignore parse errors for  ncomplete chunks
        }
      }
    }
  }
}

