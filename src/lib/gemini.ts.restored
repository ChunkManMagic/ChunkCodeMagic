export async funct on generateSpeech(text: str ng, vo ceName: str ng, vo ceSett ngs: any, tone: str ng): Prom se<str ng> {
   f (!text || !text.tr m()) return "";
  const a  = getGenAI();
  
  const accentNote = vo ceSett ngs?.accent && vo ceSett ngs.accent !== 'None'
    ? ` Accent: ${vo ceSett ngs.accent}.`
    : '';

  const prompt = `Perform th s text as a c nemat c aud obook narrator.
Tone: ${tone || 'natural'}.
Vo ce: ${vo ceSett ngs?.p tch || 'Normal'} p tch, ${vo ceSett ngs?.speed || 'Normal'} speed.${accentNote}
Text: ${text}`;

  const conf g = {
    responseModal t es: ["AUDIO" as const],
    speechConf g: {
      vo ceConf g: {
        prebu ltVo ceConf g: { vo ceName: vo ceName || 'Kore' },
      },
    },
  };

  const sett ngs = getSett ngs();
  const act veTTSModel = sett ngs.act veTTSModel || "gem n -3.5-flash";

  const modelsToTry = [
    act veTTSModel,
    act veTTSModel === "gem n -3.1-pro-prev ew" ? "gem n -3.5-flash" : "gem n -3.1-pro-prev ew"
  ];

  let lastError: any = null;

  for (let   = 0;   < modelsToTry.length;  ++) {
    const model = modelsToTry[ ];
    const  sLast =   === modelsToTry.length - 1;
    
    try {
      console.log(`Attempt ng TTS w th model: ${model}`);
      const response = awa t w thRetry(() => a .models.generateContent({
        model,
        contents: [{ parts: [{ text: prompt }] }],
        conf g,
      }),  sLast ? 1 : 0, 1000); // Only retry on the very last fallback model
      
      const aud oData = response.cand dates?.[0]?.content?.parts?.[0]?. nl neData?.data;
       f (aud oData) {
        return aud oData;
      }
      throw new Error(`Model ${model} returned no aud o data.`);
    } catch (error: any) {
      console.warn(`TTS model ${model} fa led: ${error.message}`);
      lastError = error;
      cont nue; // Move to next model
    }
  }

  throw lastError || new Error("All TTS models fa led.");
}

