{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and settings",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "settings": { "type": "object" },
        "lastActive": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Scenario": {
      "title": "Scenario",
      "description": "Scenario metadata and character profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "profile": { "type": "object" },
        "avatarBase64": { "type": "string" },
        "lastUpdated": { "type": "integer" }
      },
      "required": ["id", "profile", "lastUpdated"]
    },
    "Message": {
      "title": "Message",
      "description": "A single chat message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "model"] },
        "text": { "type": "string" },
        "timestamp": { "type": "integer" },
        "isSummarized": { "type": "boolean" }
      },
      "required": ["id", "role", "text"]
    },
    "CodexEntry": {
      "title": "CodexEntry",
      "description": "A world-building entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "isAutoGenerated": { "type": "boolean" }
      },
      "required": ["id", "title", "content", "category"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "An item in the character's inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "quantity": { "type": "integer" },
        "isAutoGenerated": { "type": "boolean" }
      },
      "required": ["id", "name", "description"]
    },
    "Summary": {
      "title": "Summary",
      "description": "The current story summary",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "lastUpdated": { "type": "integer" }
      },
      "required": ["text"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile"
    },
    "/users/{userId}/scenarios/{scenarioId}": {
      "schema": "Scenario",
      "description": "Scenario metadata"
    },
    "/users/{userId}/scenarios/{scenarioId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Chat messages"
    },
    "/users/{userId}/scenarios/{scenarioId}/codex/{entryId}": {
      "schema": "CodexEntry",
      "description": "Codex entries"
    },
    "/users/{userId}/scenarios/{scenarioId}/inventory/{itemId}": {
      "schema": "InventoryItem",
      "description": "Inventory items"
    },
    "/users/{userId}/scenarios/{scenarioId}/summary/current": {
      "schema": "Summary",
      "description": "Current story summary"
    }
  }
}
