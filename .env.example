# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_LIVE_API_KEY: Optional. Dedicated key for the Live Voice (real-time
# speech) feature via the Gemini Live API. By default it does NOT fall back to
# GEMINI_API_KEY — Live sessions can silently burn through the main text-model
# quota. Opt into that fallback explicitly:
LIVE_ALLOW_MAIN_KEY_FALLBACK="false"
GEMINI_LIVE_API_KEY="MY_GEMINI_LIVE_API_KEY"

# API_ACCESS_TOKEN: Optional shared secret protecting /api/gemini/* endpoints
# from public abuse (sent by clients as the x-api-token header). When unset,
# the server falls back to same-origin enforcement only — fine for local use,
# but set a strong random token for any publicly deployed instance.
API_ACCESS_TOKEN=

# Client-side counterpart of API_ACCESS_TOKEN (Vite env var). Leave empty when
# API_ACCESS_TOKEN is unset on the server.
VITE_API_ACCESS_TOKEN=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ElevenLabs API Key and Agent ID for Conversational AI
VITE_ELEVENLABS_API_KEY=
VITE_ELEVENLABS_AGENT_ID=

# OpenAI API Key for TTS fallback
VITE_OPENAI_API_KEY=
